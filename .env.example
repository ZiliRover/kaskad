# OpenRouter key (server-side only, never exposed to the browser).
# Project-specific name on purpose: a machine-wide OPENROUTER_API_KEY from other tools
# would otherwise override this file.
KASKAD_OPENROUTER_KEY=

# Postgres. Dev: `npm run db` starts an embedded server on this port.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/kaskad

# Where generated/uploaded files live (local disk in dev; S3 later)
STORAGE_DIR=./storage

# mock = no real API calls (placeholders; balances move by the estimate); live = real OpenRouter
PROVIDER_MODE=mock

# sample mp4 for PROVIDER_MODE=mock
MOCK_VIDEO_PATH=

# Model vendors that refuse requests from this server's region, comma-separated.
# From Russia, Google (Nano Banana, Veo, Gemini) answers "Blocked by Google AI Studio".
BLOCKED_VENDORS=

# Public https address of this server. Providers download video/audio inputs by link
# (they refuse inline files), so those inputs need it. Links are signed and expire.
PUBLIC_BASE_URL=
# Secret for signing those links (defaults to one derived from DATABASE_URL)
FILE_URL_SECRET=

# ---- accounts and money
# Operators (see the OpenRouter account balance). Unset outside production: everyone local is an operator.
ADMIN_EMAILS=
# Our price = provider cost x CBR USD/RUB rate x PRICE_MARKUP
PRICE_MARKUP=1.5
# Credited once to every new account, in rubles (0 = off)
WELCOME_BONUS_RUB=50

# Login codes by email: smtps://user:password@smtp.example.ru:465
# Without it (outside production) codes are printed to the server console and shown on the form.
SMTP_URL=
MAIL_FROM="Каскад <no-reply@example.ru>"

# test = local checkout page, no money moves (default outside production)
# yookassa = real payments; webhook URL for YooKassa: <APP_URL>/api/payments/webhook
PAYMENTS_PROVIDER=test
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Where the payment page returns the user (defaults to PUBLIC_BASE_URL, then http://localhost:3000)
APP_URL=
