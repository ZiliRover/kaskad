{
  "name": "kaskad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n db,web,worker -c gray,cyan,magenta \"npm:db\" \"npm:dev:web\" \"npm:worker\"",
    "dev:web": "next dev --port 3000",
    "db": "tsx --env-file=.env scripts/db-dev.ts",
    "db:stop": "tsx scripts/db-stop.ts",
    "db:generate": "drizzle-kit generate",
    "worker": "tsx watch --env-file=.env --clear-screen=false src/server/worker/main.ts",
    "models:sync": "tsx scripts/sync-models.ts",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@xyflow/react": "^12.12.0",
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.6",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
