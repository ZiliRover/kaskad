# OpenRouter key (server-side only, never exposed to the browser).
# Project-specific name on purpose: a machine-wide OPENROUTER_API_KEY from other tools
# would otherwise override this file.
KASKAD_OPENROUTER_KEY=

# Postgres. Dev: `npm run db` starts an embedded server on this port.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/kaskad

# Where generated/uploaded files live (local disk in dev; S3 later)
STORAGE_DIR=./storage

# mock = no real API calls (placeholders; balances move by the estimate); live = real OpenRouter
PROVIDER_MODE=mock

# sample mp4 for PROVIDER_MODE=mock
MOCK_VIDEO_PATH=

# Model vendors that refuse requests from this server's region, comma-separated.
# From Russia, Google (Nano Banana, Veo, Gemini) answers "Blocked by Google AI Studio".
BLOCKED_VENDORS=

# Public https address of this server. Providers download video/audio inputs by link
# (they refuse inline files), so those inputs need it. Links are signed and expire.
PUBLIC_BASE_URL=
# Secret for signing those links (defaults to one derived from DATABASE_URL)
FILE_URL_SECRET=

# ---- accounts and money
# Font for the text-on-image/video tools (TTF with Cyrillic). Default: Arial Bold on Windows,
# DejaVu Sans Bold on Linux.
OVERLAY_FONT=

# Font family name for subtitles when OVERLAY_FONT is not Arial, Segoe UI or DejaVu Sans
OVERLAY_FONT_FAMILY=

# invite = only accounts added with `npm run invite -- email [rub]` and ADMIN_EMAILS may sign in;
# open (default) = anyone. In production the test checkout is always off and only
# KASKAD_OPENROUTER_KEY is used (a machine-wide OPENROUTER_API_KEY is ignored).
SIGNUP_MODE=open
# Operators, comma-separated: run without a balance limit and see the OpenRouter balance.
# Nobody else sees it.
ADMIN_EMAILS=
# Our price = provider cost x CBR USD/RUB rate x PRICE_MARKUP
PRICE_MARKUP=1.5
# Credited once to every new account, in rubles (0 = off)
WELCOME_BONUS_RUB=50
# The bonus is not given to throwaway mail domains or beyond 3 accounts per IP in 30 days.
# Put the app behind a proxy that sets X-Forwarded-For itself, or the limit can be dodged.

# Login codes by email: smtps://user:password@smtp.example.ru:465
# Without it (outside production) codes are printed to the server console and shown on the form.
SMTP_URL=
MAIL_FROM="Каскад <no-reply@example.ru>"

# test = local checkout page, no money moves (development only, never in production)
# robokassa = real payments (cards, SBP, SberPay). In the shop's technical settings:
#   Result URL  <APP_URL>/api/payments/robokassa/result
#   Success URL <APP_URL>/api/payments/robokassa/return
#   Fail URL    <APP_URL>/api/payments/robokassa/return?failed=1
PAYMENTS_PROVIDER=test
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
# 1 = Robokassa test mode (use the shop's TEST passwords above while it's on)
ROBOKASSA_TEST=
# hash algorithm from the technical settings: md5 (default), sha256, sha384, sha512
ROBOKASSA_HASH=md5
# Public address of the site, for return links (defaults to PUBLIC_BASE_URL)
APP_URL=

# Shown on /terms and /privacy. Fill in before taking real payments.
LEGAL_NAME=
LEGAL_INN=
SUPPORT_EMAIL=
# Date the current terms took effect, as text (default: 29 сентября 2026 г.)
LEGAL_UPDATED=
